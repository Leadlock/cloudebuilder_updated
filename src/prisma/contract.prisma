// use prisma-next

// ─── Auth / Identity ───────────────────────────────────────────────────────────

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  avatarUrl    String?
  // scrypt-derived, format "<saltHex>:<hashHex>". Null for legacy/unmigrated rows.
  passwordHash String?
  createdAt    String
  updatedAt    String

  memberships   OrgMember[]
  ownedProjects Project[]   @relation("ProjectOwner")
}

model Organization {
  id        String @id @default(uuid())
  name      String
  slug      String @unique
  createdAt String
  updatedAt String

  members       OrgMember[]
  projects      Project[]
  cloudAccounts CloudAccount[]
  invites       OrgInvite[]
}

model OrgMember {
  id     String @id @default(uuid())
  role   String @default("member")
  orgId  String
  userId String

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

// ─── Org Invites ────────────────────────────────────────────────────────────

model OrgInvite {
  id              String  @id @default(uuid())
  orgId           String
  email           String
  role            String  @default("member")
  // Opaque random token mailed to the invitee; never guessable.
  token           String  @unique
  invitedByUserId String
  createdAt       String
  expiresAt       String
  acceptedAt      String?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id          String @id @default(uuid())
  name        String
  description String @default("")
  provider    String
  region      String
  tags        String @default("[]")
  createdAt   String
  updatedAt   String
  orgId       String
  ownerId     String

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner User         @relation("ProjectOwner", fields: [ownerId], references: [id])

  environments         Environment[]
  architectureVersions ArchitectureVersion[]
  securityScans        SecurityScan[]
  costEstimates        CostEstimate[]
  optimizations        ArchOptimization[]
  terraformGens        TerraformGeneration[]
  wellArchitectedAssessments WellArchitectedAssessment[]
  wellArchitectedAnswers WellArchitectedAnswer[]
  accountControlEvidence AccountControlEvidence[]
  aiGenerationHistory  AIGenerationHistory[]
  complianceAssessments ComplianceAssessment[]
  exportJobs           ExportJob[]
  gitOperations        GitOperation[]
  githubConnections    GithubConnection[]
  findingReviews       FindingReview[]

  @@index([orgId])
}

// ─── Environments ─────────────────────────────────────────────────────────────

model Environment {
  id        String @id @default(uuid())
  envKey    String
  label     String
  region    String
  createdAt String
  updatedAt String
  projectId String

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architectures Architecture[]

  @@unique([projectId, envKey])
}

// ─── Architecture ─────────────────────────────────────────────────────────────

model Architecture {
  id            String @id @default(uuid())
  createdAt     String
  updatedAt     String
  environmentId String @unique
  // Optimistic-concurrency counter, persisted in the DB (not in-process memory)
  // so revision conflicts are detected correctly even across multiple server
  // instances. Incremented atomically inside the same transaction as the
  // canvas save — see architectureRepository.saveCanvas.
  revision      Int    @default(1)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  resources   ArchitectureResource[]
  connections ArchitectureConnection[]
  versions    ArchitectureVersion[]
  securityScans SecurityScan[]
  costEstimates CostEstimate[]
  optimizations ArchOptimization[]
  terraformGens TerraformGeneration[]
  wellArchitectedAssessments WellArchitectedAssessment[]
  aiGenerationHistory  AIGenerationHistory[]
  complianceAssessments ComplianceAssessment[]
  exportJobs           ExportJob[]
}

// ─── ArchitectureResource ─────────────────────────────────────────────────────

model ArchitectureResource {
  id             String  @id @default(uuid())
  resourceType   String
  provider       String
  label          String
  positionX      Float   @default(0)
  positionY      Float   @default(0)
  configJson     String
  region         String?
  groupId        String?
  locked         Boolean @default(false)
  architectureId String

  architecture      Architecture            @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  sourceConnections ArchitectureConnection[] @relation("ConnectionSource")
  targetConnections ArchitectureConnection[] @relation("ConnectionTarget")

  @@index([architectureId, resourceType])
}

// ─── ArchitectureConnection ───────────────────────────────────────────────────

model ArchitectureConnection {
  id             String  @id @default(uuid())
  label          String?
  edgeType       String?
  architectureId String
  sourceId       String
  targetId       String

  architecture Architecture         @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  source       ArchitectureResource @relation("ConnectionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       ArchitectureResource @relation("ConnectionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([architectureId])
}

// ─── ArchitectureVersion ─────────────────────────────────────────────────────

model ArchitectureVersion {
  id             String @id @default(uuid())
  versionNumber  Int
  label          String
  summary        String
  author         String @default("Unknown")
  snapshotJson   String
  createdAt      String
  projectId      String
  architectureId String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)
}

// ─── Cloud Accounts ───────────────────────────────────────────────────────────
// SECURITY: credentialsJson stores credentials server-side only.
// credentialsJson is NEVER returned to the browser through any API response.

model CloudAccount {
  id              String  @id @default(uuid())
  orgId           String
  provider        String
  name            String
  // Encrypted JSON: AWS role ARN + external ID, or Azure SP credentials. Never exposed.
  credentialsJson String
  // Sanitised identity info returned from provider (account ID, ARN, etc.)
  identityJson    String  @default("{}")
  // active | invalid | pending
  status          String  @default("pending")
  lastValidatedAt String?
  createdAt       String
  updatedAt       String

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  discoveryRuns DiscoveryRun[]

  @@index([orgId])
}

// ─── Discovery Runs ───────────────────────────────────────────────────────────

model DiscoveryRun {
  id             String  @id @default(uuid())
  cloudAccountId String
  // pending | running | completed | failed
  status         String  @default("pending")
  startedAt      String
  completedAt    String?
  // JSON array of DiscoveredResource objects — sanitised, no credentials
  resourcesJson  String  @default("[]")
  // JSON array of CloudRelationship objects (containment/network/traffic/
  // security/storage edges reconstructed by the adapter) — previously
  // computed by discoverTopology() and then discarded before reaching the
  // canvas; now persisted so the normalizer can use the adapter's precise
  // relationship graph instead of only its own heuristic reconstruction.
  relationshipsJson String @default("[]")
  // JSON summary counts by resource type
  summaryJson    String  @default("{}")
  error          String?

  cloudAccount CloudAccount @relation(fields: [cloudAccountId], references: [id], onDelete: Cascade)

  @@index([cloudAccountId])
}

// ─── Phase 2D: Security Scans ─────────────────────────────────────────────────

model SecurityScan {
  id             String  @id @default(uuid())
  projectId      String
  architectureId String
  versionId      String?
  status         String  @default("completed")
  score          Int     @default(0)
  findingsJson   String  @default("[]")
  createdAt      String
  completedAt    String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  findings     SecurityFinding[]

  @@index([projectId])
  @@index([architectureId])
}

// ─── Security finding review (risk acceptance / false positive) ──────────────
// A review NEVER changes the technical evaluation: an accepted-risk finding
// still evaluates to FAIL and still counts against the score. Keyed by the
// engine's stable findingId (<ruleId>-<resource hash>) so it survives re-scans.

model FindingReview {
  id         String  @id @default(uuid())
  projectId  String
  findingId  String
  ruleId     String
  status     String  // ACCEPTED_RISK | FALSE_POSITIVE | NOT_APPLICABLE
  reason     String
  approvedBy String
  approvedAt String
  expiresAt  String?
  revokedAt  String?
  revokedBy  String?
  createdAt  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, findingId])
}

model SecurityFinding {
  id           String @id @default(uuid())
  scanId       String
  ruleId       String
  severity     String
  title        String
  description  String
  resourceId   String?
  provider     String?
  resourceType String?
  remediation  String
  metaJson     String @default("{}")
  createdAt    String

  scan SecurityScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

// ─── Phase 2D: Cost Estimates ─────────────────────────────────────────────────

model CostEstimate {
  id             String @id @default(uuid())
  projectId      String
  architectureId String
  versionId      String?
  currency       String @default("USD")
  totalMonthly   Float  @default(0)
  totalHourly    Float  @default(0)
  itemsJson      String @default("[]")
  assumptionsJson String @default("[]")
  pricingSource  String @default("static-list-price")
  confidence     String @default("estimate")
  createdAt      String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([architectureId])
}

// ─── Phase 2D: Cost / Architecture Optimizations ──────────────────────────────

model ArchOptimization {
  id             String @id @default(uuid())
  projectId      String
  architectureId String
  versionId      String?
  recommendationsJson String @default("[]")
  scoreJson      String @default("{}")
  createdAt      String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([architectureId])
}

// ─── Phase 2D: Terraform Generations ─────────────────────────────────────────

model TerraformGeneration {
  id             String @id @default(uuid())
  projectId      String
  architectureId String
  versionId      String?
  filesJson      String @default("{}")
  warningsJson   String @default("[]")
  resourceMapJson String @default("{}")
  createdAt      String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([architectureId])
}

// ─── Multi-Currency & Live Exchange Rates Cache ──────────────────────────────

model CurrencyExchangeRate {
  id             String @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Float
  source         String
  retrievedAt    String
  expiresAt      String

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency, targetCurrency])
}

// ─── Well-Architected Assessments ─────────────────────────────────────────────

model WellArchitectedAssessment {
  id               String  @id @default(uuid())
  projectId        String
  architectureId   String
  provider         String  // 'aws' | 'azure' | 'multi'
  framework        String  // e.g. 'AWS Well-Architected Framework'
  frameworkVersion String  // e.g. '2024'
  overallScore     Int     @default(0)
  pillarScoresJson String  @default("[]")
  findingsJson     String  @default("[]")
  source           String  // 'DESIGN_TIME' | 'LIVE_AWS_WAF' | 'LIVE_AZURE_ADVISOR'
  sourceLabel      String  @default("Design-time assessment")
  confidence       String  @default("design-time")
  isStale          Boolean @default(false)
  // Ruleset (RULESET_VERSION) that produced this review; '' for reviews saved before it was recorded. A review from another ruleset is stale.
  rulesetVersion   String  @default("")
  createdAt        String
  completedAt      String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  findings     WellArchitectedFinding[]

  @@index([projectId])
  @@index([architectureId])
}

model WellArchitectedFinding {
  id                  String  @id @default(uuid())
  assessmentId        String
  ruleId              String
  provider            String
  pillar              String
  pillarLabel         String
  pillarRef           String
  severity            String
  title               String
  description         String
  affectedResourceIds String  @default("[]")
  evidenceJson        String  @default("{}")
  recommendation      String
  remediation         String
  frameworkReference  String
  source              String
  sourceLabel         String
  resourceState       String?
  detectedAt          String

  assessment WellArchitectedAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// ─── Well-Architected questionnaire ───────────────────────────────────────────
// Answers to the practice questions a diagram cannot answer (backups restored, on-call, budget owner…). They describe how the
// WORKLOAD is run, so they belong to the project, not to one environment. One row per project and question.
model WellArchitectedAnswer {
  id         String @id @default(uuid())
  projectId  String
  // Stable id from lib/engines/assessment/questionnaire/questions.ts, e.g. "REL-01"
  questionId String
  // 'yes' | 'partial' | 'no' | 'na' | 'unknown'
  answer     String
  note       String @default("")
  answeredBy String @default("")
  createdAt  String
  updatedAt  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, questionId])
  @@index([projectId])
}

// ─── Account-level control evidence ───────────────────────────────────────────
// Dated readings of account settings a diagram cannot show (CloudTrail, GuardDuty, root MFA, AWS Config), taken read-only through a
// connected AWS account. One row per project and control; a new check replaces the old reading. The assessment uses a reading for seven
// days. Only plain sentences are stored: never raw API output, credentials or account identifiers.
model AccountControlEvidence {
  id             String @id @default(uuid())
  projectId      String
  // The connected account that was read (a CloudAccount id; kept without a relation so the reading survives for the audit trail)
  cloudAccountId String
  accountLabel   String @default("")
  // The assessment rule id, e.g. "AWS-ACCT-001"
  controlId      String
  // 'PASS' | 'WARNING' | 'FAIL' | 'UNAVAILABLE'
  status         String
  observation    String
  observedAt     String
  checkedBy      String @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, controlId])
  @@index([projectId])
}

// ─── AI Generation History ────────────────────────────────────────────────────

model AIGenerationHistory {
  id               String  @id @default(uuid())
  projectId        String
  architectureId   String
  prompt           String
  provider         String  @default("gemini")
  model            String  @default("gemini-1.5-pro")
  status           String  @default("completed")
  architectureJson String
  createdAt        String
  completedAt      String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([architectureId])
}

// ─── Compliance ────────────────────────────────────────────────────────────────

model ComplianceAssessment {
  id             String  @id @default(uuid())
  projectId      String
  architectureId String
  framework      String
  status         String  @default("completed")
  overallScore   Int     @default(0)
  findingsJson   String  @default("[]")
  createdAt      String
  completedAt    String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  findings     ComplianceFinding[]

  @@index([projectId])
  @@index([architectureId])
}

model ComplianceFinding {
  id                  String @id @default(uuid())
  assessmentId        String
  ruleId              String
  controlId           String
  severity            String
  title               String
  description         String
  affectedResourceIds String @default("[]")
  recommendation      String
  remediation         String
  createdAt           String

  assessment ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

// ─── Export Jobs ───────────────────────────────────────────────────────────────

model ExportJob {
  id             String  @id @default(uuid())
  projectId      String
  architectureId String
  format         String
  status         String  @default("completed")
  url            String?
  createdAt      String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([architectureId])
}

// ─── GitOps ────────────────────────────────────────────────────────────────────

model GitOperation {
  id            String  @id @default(uuid())
  projectId     String
  operationType String  @default("commit")
  status        String  @default("pending")
  commitSha     String?
  prUrl         String?
  createdAt     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GithubConnection {
  id             String  @id @default(uuid())
  projectId      String
  githubOrg      String
  githubRepo     String
  branch         String  @default("main")
  installationId String?
  status         String  @default("active")
  createdAt      String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Append-only record of Terraform plan / apply / destroy activity: who asked, for which org and project, what plan
/// (by hash), and what happened — including refusals. Written best-effort; see lib/terraform/execution/audit.ts.
model TerraformAuditEvent {
  id        String  @id @default(uuid())
  createdAt String
  orgId     String?
  projectId String?
  userId    String?
  // plan | apply | destroy
  action    String
  // requested | allowed | denied | blocked | succeeded | failed
  outcome   String
  planId    String?
  planHash  String?
  detail    String?

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
}

// One row per rate-limit key (user + route, or IP + auth action). Shared by every server instance so a limit is global,
// not multiplied by the number of instances. Times are epoch milliseconds from the DATABASE clock (no clock skew between
// instances). Rows are deleted once expiresAtMs has passed.
model RateLimitBucket {
  key           String @id
  count         Int    @default(0)
  windowStartMs Float
  expiresAtMs   Float

  @@index([expiresAtMs])
}

// Sessions that were signed out. Session tokens are stateless, so a logout is only effective if every server instance
// knows about it. id is sha256(token) for one token (kind = token) or "user:<userId>" for "every session issued up to
// revokedAtMs" (kind = user). Rows are deleted once expiresAtMs has passed (the token could not be used any more anyway).
model RevokedSession {
  id          String @id
  kind        String
  userId      String?
  revokedAtMs Float
  expiresAtMs Float

  @@index([expiresAtMs])
}

// A request to run a specific Terraform plan (apply) or teardown (destroy), and the decision on it. A plan can only be run
// with an approved, unexpired, unused approval for exactly this plan (planId + planHash) — see lib/terraform/execution/approvals.ts.
// status: pending | approved | rejected | used. expiresAtMs is epoch milliseconds from the DATABASE clock: a pending request
// expires if nobody decides, an approved one if it is not used in time.
model TerraformApproval {
  id          String  @id @default(uuid())
  createdAt   String
  orgId       String
  projectId   String
  // apply | destroy
  action      String
  planId      String
  planHash    String
  // Short description of what is being approved ("3 to add, 1 to change, 0 to destroy"); never secrets.
  summary     String?
  requestedBy String
  status      String
  decidedBy   String?
  decidedAt   String?
  comment     String?
  expiresAtMs Float
  usedAt      String?

  @@index([projectId, createdAt])
  @@index([orgId, status])
}

// The organization's policy: the regions, instance sizes, tags and naming standard its architectures should follow. One row per organization;
// `policyJson` holds the rules (validated by lib/engines/policy/schema.ts on every write and read). `version` counts saves. Violations are
// advisory warnings for now — see lib/engines/policy.
model OrgPolicy {
  id         String @id @default(uuid())
  orgId      String @unique
  policyJson String
  version    Int    @default(1)
  updatedAt  String
  updatedBy  String
}

// Random passwords CloudCraft generated for a cloud account's deployments (database / admin passwords), encrypted with the credential key and
// bound to this row. id is "<cloudAccountId>:<name>". Never returned by an API except to an owner/admin who asks for it.
model DeploymentSecret {
  id             String @id
  orgId          String
  cloudAccountId String
  name           String
  valueEnc       String
  createdAt      String

  @@index([cloudAccountId])
}

// A person's authenticator-app (TOTP) setup, used to confirm deploys and teardowns on top of their password. secretEnc is encrypted with the
// credential key and bound to the user. lastStep is the last accepted 30-second step (a code can never be used twice). recoveryJson holds
// sha256 hashes of unused recovery codes, never the codes. enabled is false until the person proves their app works by entering a code.
model UserTotp {
  userId       String  @id
  secretEnc    String
  enabled      Boolean @default(false)
  lastStep     Float   @default(0)
  recoveryJson String  @default("[]")
  createdAt    String
}

// A container configuration (Container Templates form) an organization saved to use again. configJson is the form's ContainerConfig; it
// holds no secret values (a variable marked secret never has its value stored), and is re-validated whenever it is read.
model ContainerTemplate {
  id         String @id @default(uuid())
  orgId      String
  name       String
  configJson String
  createdBy  String
  createdAt  String
  updatedAt  String

  @@index([orgId])
}

// Whether an organization may run Terraform plan / apply / destroy on this server (one row per organization). An operator decides, or the
// organization qualifies automatically when the server allows that and every check passes. checksJson is the checks as they were when the
// request was made, so an operator can see why it was or was not approved automatically. status: approved | requested | denied | revoked.
// source: auto | operator.
model TerraformAccess {
  id          String  @id @default(uuid())
  orgId       String  @unique
  status      String
  source      String
  requestedBy String?
  requestedAt String?
  decidedBy   String?
  decidedAt   String?
  note        String?
  checksJson  String  @default("[]")
  updatedAt   String
}

// A deployment of a whole project run from inside CloudCraft (lib/deploy/project): one row per release. `dataJson` holds the release record
// (steps, the project's settings, the compose file, the ids of what was created): never a credential and never a secret value.
model ProjectRelease {
  id            String  @id @default(uuid())
  orgId         String
  projectId     String
  environment   String
  // The project's name (it names the resource group, the VM and the images).
  project       String
  target        String
  bundleHash    String
  planId        String?
  planHash      String?
  imageTag      String
  // planned | approved | running | waiting | succeeded | failed | rolled_back | cancelled
  status        String
  createdBy     String
  createdAtMs   Float
  updatedAtMs   Float
  dataJson      String

  @@index([projectId, environment, updatedAtMs])
  @@index([orgId, status])
}

// The zip of a service's own code, uploaded to be built in a project release (lib/deploy/project/sourceStore.ts). Kept for a few days, then removed;
// `dataB64` is the zip as the person uploaded it, read again with the same safety checks when it is used.
model ProjectSource {
  id          String @id @default(uuid())
  orgId       String
  projectId   String
  layer       String
  sha256      String
  sizeBytes   Float
  dataB64     String
  createdAtMs Float
  expiresAtMs Float

  @@index([projectId, expiresAtMs])
}

// An architecture template of the Templates gallery. The built-in ones (orgId empty, source 'builtin') are written here from the code by
// lib/templates/sync.ts, so the list can be read, exported and uploaded from the database; an organization's own (orgId set, source 'org') are saved
// by its members. `graphJson` is the template's default graph ({ nodes, edges }); `metaJson` holds the descriptive fields the gallery shows
// (pattern, use cases, availability, scale, data flow, source references, flags). `contentHash` lets the sync see what changed.
model ArchitectureTemplate {
  id          String  @id
  orgId       String?
  source      String
  name        String
  description String
  provider    String
  category    String
  complexity  String
  tagsJson    String  @default("[]")
  featuresJson String @default("[]")
  estimatedCost Float
  resourceCount Float
  metaJson    String  @default("{}")
  graphJson   String
  contentHash String
  createdBy   String?
  createdAt   String
  updatedAt   String

  @@index([orgId])
  @@index([source])
}

// A read-only API key an organization's administrator made so another system (a marketplace, a script) can read its architecture templates
// (lib/apiKeys). Only the SHA-256 hash of the key is stored; the key itself is shown once, when it is made. `scope` says what it may read.
// includeBuiltin / includeOwn choose which templates it can see: the built-in ones, the organization's own, or both.
model ApiKey {
  id             String  @id @default(uuid())
  orgId          String
  name           String
  keyPrefix      String
  keyHash        String  @unique
  scope          String
  includeBuiltin Boolean @default(true)
  includeOwn     Boolean @default(true)
  createdBy      String
  createdAt      String
  expiresAt      String?
  lastUsedAt     String?
  revokedAt      String?

  @@index([orgId])
}
