{
  "name": "cloudcraft",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --config jest.config.mjs",
    "test:unit": "jest --config jest.config.mjs --testPathIgnorePatterns /node_modules/ /__tests__/live/ \\.integration\\.test\\.ts$",
    "test:integration": "jest --config jest.config.mjs --testPathPatterns='\\.integration\\.test\\.ts$'",
    "test:live": "jest --config jest.live.config.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:update": "prisma db update",
    "db:reset": "docker compose down -v && docker compose up -d && prisma db init",
    "credentials:rotate": "tsx --env-file=.env --tsconfig tsconfig.json scripts/rotate-credentials.ts",
    "credentials:new-key": "tsx --tsconfig tsconfig.json scripts/new-encryption-key.ts",
    "worker:discovery": "tsx workers/discoveryWorker.ts",
    "worker:terraform-apply": "tsx workers/terraformApplyWorker.ts",
    "terraform:destroy": "tsx scripts/destroy-infrastructure.ts",
    "auth:list-local-accounts": "tsx --env-file=.env --tsconfig tsconfig.json scripts/auth/list-local-accounts.ts",
    "docs:rule-matrix": "tsx --tsconfig tsconfig.json scripts/generate-rule-matrix.ts",
    "ai:dataset": "tsx --tsconfig tsconfig.json scripts/ai-dataset/build-dataset.ts",
    "ai:knowledge-base": "tsx --tsconfig tsconfig.json scripts/ai-dataset/build-knowledge-base.ts",
    "ai:evaluate": "tsx --tsconfig tsconfig.json scripts/ai-dataset/evaluate-model.ts",
    "ai:finetune": "tsx --env-file=.env --tsconfig tsconfig.json scripts/ai-dataset/finetune-foundry.ts",
    "ai:kb-embed": "tsx --env-file=.env --tsconfig tsconfig.json scripts/ai-dataset/build-kb-embeddings.ts"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1138.0",
    "@aws-sdk/client-cloudfront": "^3.1138.0",
    "@aws-sdk/client-cloudwatch": "^3.1135.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/client-ec2": "^3.1127.0",
    "@aws-sdk/client-ecs": "^3.1138.0",
    "@aws-sdk/client-eks": "^3.1138.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1127.0",
    "@aws-sdk/client-elasticache": "^3.1138.0",
    "@aws-sdk/client-iam": "^3.1138.0",
    "@aws-sdk/client-kms": "^3.1138.0",
    "@aws-sdk/client-lambda": "^3.1138.0",
    "@aws-sdk/client-pricing": "^3.1138.0",
    "@aws-sdk/client-rds": "^3.1127.0",
    "@aws-sdk/client-route-53": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1141.0",
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/client-wafv2": "^3.1138.0",
    "@aws-sdk/client-wellarchitected": "^3.1130.0",
    "@azure/arm-advisor": "^3.2.0",
    "@azure/arm-appservice": "^19.0.0",
    "@azure/arm-cdn": "^10.0.0",
    "@azure/arm-compute": "^25.1.1",
    "@azure/arm-containerservice": "^25.5.0",
    "@azure/arm-cosmosdb": "^17.0.0",
    "@azure/arm-keyvault": "^5.0.0",
    "@azure/arm-network": "^38.0.0",
    "@azure/arm-rediscache": "^8.2.0",
    "@azure/arm-resources": "^8.0.0",
    "@azure/arm-sql": "^11.0.0",
    "@azure/arm-storage": "^20.1.0",
    "@azure/identity": "^4.13.2",
    "@google/genai": "^2.23.0",
    "@octokit/rest": "^22.0.1",
    "@prisma/cli-engine": "^0.3.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "aws-jwt-verify": "^5.2.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.12",
    "openai": "^7.23.0",
    "pdfkit": "^0.20.2",
    "pg-boss": "^12.33.6",
    "prisma": "^8.0.0-rc.13",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reactflow": "^11.11.4",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.2",
    "jest-environment-node": "^30.5.1",
    "pg-mem": "^3.0.14",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
