# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://neondb_owner:****************@ep-hidden-art-b3xzdvms-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Application
NODE_ENV="development"

# ─── Credential encryption ────────────────────────────────────────────────────
# REQUIRED — AES-256-GCM key for encrypting cloud credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be a 64-character lowercase hexadecimal string (32 bytes / 256 bits).
# If absent or too short the application will refuse to store or read credentials.
ENCRYPTION_KEY="e48fd4467754e78b5059059caa3c5756abe5fee7310b3920d5f971ff7bf75eba"

# ─── Live Currency Exchange Rates ─────────────────────────────────────────────
# Optional: API key if using custom authenticated Forex provider.
# Default uses open.er-api.com and European Central Bank reference rates (public access, no key required).
# EXCHANGE_RATE_API_KEY="your-api-key-here"
# Cache TTL in milliseconds (default: 43200000 = 12 hours)
# EXCHANGE_RATE_CACHE_TTL_MS=43200000
