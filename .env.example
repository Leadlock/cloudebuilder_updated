# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cloudcraft_dev"

# Application
NODE_ENV="development"

# In production the server checks its secrets when it starts (lib/startup/productionChecks.ts) and exits with the full list of problems
# if SESSION_SECRET or ENCRYPTION_KEY is missing, an example or weak, if they are the same value, or if DATABASE_URL is missing.

# OPTIONAL - limit who can sign up, sign in and be invited to people whose email is on these domains (comma separated). Empty means anyone.
# People already signed in with another domain are signed out at once; their data is not deleted. Remove the line to open the app again.
# ALLOWED_EMAIL_DOMAINS=neozaar.com

# OPTIONAL - close the Deploy tab (Terraform plan, apply, destroy), the AI Generator and Cloud Accounts to everyone except these email addresses (comma separated).
# Enforced on the server and hidden in the interface. Empty means open to everyone who can sign in.
# RESTRICTED_FEATURES_ALLOWED_EMAILS=ajinkya@neozaar.com

# OPTIONAL - the super administrator(s), comma separated. Only they can approve, reject or send back an architecture review (a review is
# assigned to them when it is submitted), so nothing is planned or deployed without their approval. They are an owner of every organization
# they belong to (never of one they do not). Empty means any organization admin decides reviews, as before.
# SUPER_ADMIN_EMAILS=ajinkya@neozaar.com

# ─── Credential encryption ────────────────────────────────────────────────────
# REQUIRED - AES-256-GCM key for encrypting cloud credentials at rest. NO DEFAULT: generate your own, never reuse an example.
# Generate with: npm run credentials:new-key
# Must be exactly 64 hexadecimal characters (256 random bits). Production refuses anything else.
# Without it the application refuses to store or read credentials.
ENCRYPTION_KEY=

# OPTIONAL - older keys that stored data may still be encrypted with, comma separated. For rotating the key:
#   1. npm run credentials:new-key            (make a new key)
#   2. put the OLD key here, the NEW key in ENCRYPTION_KEY, restart the app and the workers
#   3. npm run credentials:rotate             (re-encrypts everything with the new key; add --dry-run to preview)
#   4. when it reports nothing left on an old key, remove it from this line
# ENCRYPTION_KEYS_PREVIOUS=

# ─── Session signing ───────────────────────────────────────────────────────────
# REQUIRED — HMAC key that signs the stateless session token every logged-in
# request presents (see lib/crypto/sessionToken.ts). Sessions are NOT stored
# server-side; any process holding this same secret can verify a session, which
# is what lets logins survive across multiple ECS task instances/restarts. If
# absent or under 32 characters the app refuses to mint or verify sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session (forces re-login).
SESSION_SECRET=

# ─── Auth ──────────────────────────────────────────────────────────────────
# DANGER — leave unset. When "1", API routes accept an `x-user-id` header as
# a trusted identity with no password or session, bypassing real auth. Only
# ever set by the automated test runner (__tests__/setup.ts); never set this
# in a real dev/staging/production environment.
# CLOUDCRAFT_ALLOW_TEST_AUTH_HEADERS="1"

# ─── Live AWS Pricing (Price List Query API) ─────────────────────────────────
# Optional. A dedicated, least-privilege IAM user/role credential used ONLY to
# call the AWS Price List Query API (pricing:GetProducts, pricing:DescribeServices)
# for live EC2/RDS/S3/EBS/ALB pricing lookups. This is NOT a connected user's
# cloud account credential — it's a service-level credential CloudCraft itself
# owns, since design-time cost estimation isn't tied to any specific account.
# If unset, AWS pricing falls back to static reference rate tables (Azure
# pricing is unaffected — it uses the public, unauthenticated Azure Retail
# Prices API and needs no credential).
# AWS_PRICING_ACCESS_KEY_ID="AKIA..."
# AWS_PRICING_SECRET_ACCESS_KEY="..."

# ─── Terraform plan/apply execution ────────────────────────────────────────
# No separate credential — it reuses whichever CloudAccount the admin selects
# when generating a plan (POST /api/projects/:id/terraform/plan). Two real
# operational prerequisites this app does NOT provision for you:
# 1. The `terraform` CLI must be installed and on PATH for both the main
#    server process (plan) and the worker process (apply) — see
#    lib/terraform/execution/cli.ts.
# 2. The connected CloudAccount's IAM role/service principal needs WRITE
#    permissions for whatever resources it will create/modify. The
#    discovery-only REQUIRED_AWS_PERMISSIONS / REQUIRED_AZURE_PERMISSIONS
#    lists in lib/cloud/adapters/*.ts are read-only and are NOT sufficient.
# A remote Terraform state backend (S3+DynamoDB for AWS, Azure Storage for
# Azure) is required on every plan request — supplied in the request body,
# not an env var here — and must already exist; CloudCraft does not
# provision it. Plans that would destroy any resource are refused outright.

# ─── Live Currency Exchange Rates ─────────────────────────────────────────────
# No configuration needed. lib/currency/CurrencyExchangeRateService.ts uses
# open.er-api.com then api.frankfurter.dev (ECB reference rates) as a
# fallback chain, both public/unauthenticated. Cache TTL is a fixed 12h
# constant (lib/currency/CurrencyExchangeRateCache.ts DEFAULT_EXCHANGE_RATE_TTL_MS).
# There is intentionally no EXCHANGE_RATE_API_KEY / EXCHANGE_RATE_CACHE_TTL_MS
# env var — neither provider needs a key, and the TTL isn't currently
# runtime-configurable; earlier versions of this file documented both as if
# they were read by the code, which they never were.

# ─── AWS Cognito Authentication ───────────────────────────────────────────────
# Optional / Production authentication provider.
COGNITO_USER_POOL_ID="us-east-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_CLIENT_SECRET=""
COGNITO_REGION="us-east-1"
AWS_REGION="us-east-1"

# ─── Azure AI Foundry (AI architecture generator) ─────────────────────────────
# REQUIRED for the AI Generator feature (lib/services/AiGeneratorService.ts).
# Uses the standard `openai` SDK pointed at Azure AI Foundry's OpenAI-compatible
# v1 Responses API — no Azure-specific client or api-version needed.
# Get these from your Foundry project's deployment page (Azure AI Foundry portal).
# AZURE_AI_FOUNDRY_ENDPOINT is the full deployment URL shown in the portal,
# ending in "/responses" — the trailing segment is stripped in code to build
# the SDK base URL.
AZURE_AI_FOUNDRY_ENDPOINT="https://<your-resource>.services.ai.azure.com/openai/v1/responses"
AZURE_AI_FOUNDRY_API_KEY=""
AZURE_AI_FOUNDRY_DEPLOYMENT="gpt-4o"

# Embedding deployment used to search the knowledge base (datasets/ai-architect/knowledge-base). Optional:
# defaults to "text-embedding-3-small". If it is unreachable the AI features fall back to keyword search.
# Regenerate vectors after changing the knowledge base with: npm run ai:knowledge-base && npm run ai:kb-embed
# AZURE_AI_FOUNDRY_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
# Set to "false" to run the AI generator/reviewer without knowledge-base context.
# AI_KB_ENABLED="true"
# Set to "false" once the fine-tuned model is deployed: it has learned the catalog, so generation no longer needs the
# knowledge-base context on every request (the AI reviewer keeps using it).
# AI_KB_GENERATION="true"

# ─── AWS SES / Outbound SMTP (Team Invites & Notifications) ───────────────────
# Optional / Production email delivery.
SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
SMTP_PORT="587"
SMTP_USER="<ses-smtp-username>"
SMTP_PASS="<ses-smtp-password>"
SMTP_SECURE="false"
EMAIL_FROM="CloudCraft <noreply@yourdomain.com>"
APP_URL="http://localhost:3000"

# Terraform plan/apply/destroy run a process on this server with real cloud credentials, so they are DENIED by default.
# List the organization ids allowed to use them (comma-separated). Callers must also be an owner/admin of that org.
# Local development with this unset: your own org is allowed only if you also set CLOUDCRAFT_DEV_SHORTCUTS=1 (below). Setting this list turns that off.
# CLOUDCRAFT_TERRAFORM_ORG_IDS="org-id-1,org-id-2"
#
# Nothing here has to be set. Organizations are not listed by hand:
#  - the person who first signed up on this server is the operator and sees "Deploy access" in the sidebar; they enable Terraform for their own
#    organization with one click and can approve, deny or revoke any other organization there;
#  - any other organization enables it itself once its owner has the authenticator app on, it has a cloud account that passed its check and (on a
#    production server) the server has its own ENCRYPTION_KEY; otherwise the request waits for an operator.
# The lines below are overrides, for when you want different behaviour. The list above stays an override too: organizations on it are always allowed.
# Name the operators explicitly (comma-separated emails). When set, only these people are operators and the first-signup rule is not used.
# CLOUDCRAFT_OPERATOR_EMAILS="you@example.com"
# Automatic approval is on. Set to 0 to make every request wait for an operator (an operator can still revoke any organization at any time).
# CLOUDCRAFT_TERRAFORM_AUTO_APPROVE=0

# Terraform comes with CloudCraft: the first time it is needed and none is found, the server downloads the pinned release from HashiCorp, checks it
# against the checksum built into the code, and keeps it under ~/.cloudcraft/terraform. Nothing to install and nothing to set. Optional overrides:
# TERRAFORM_BINARY_PATH=/path/to/terraform        use this Terraform instead of the managed copy
# CLOUDCRAFT_TERRAFORM_DIR=/var/lib/cloudcraft/terraform   where the managed copy is kept
# CLOUDCRAFT_TERRAFORM_MIRROR=https://mirror.example/terraform   fetch from an internal mirror (same file layout; still checked against the built-in checksums)
# CLOUDCRAFT_TERRAFORM_DOWNLOAD=0                 never download (machines with no internet: install Terraform yourself)
# To fetch it before the first deploy: npm run terraform:install

# Terraform safety controls (see lib/terraform/execution/planGuardrails.ts)
# Emergency stop: set to 1 to refuse every Terraform plan / apply / destroy immediately (queued applies are refused too).
# CLOUDCRAFT_TERRAFORM_DISABLED="1"
# Refuse plans that would create or change more than this many resources in one run (default 200).
# CLOUDCRAFT_TERRAFORM_MAX_RESOURCES="200"
# Only allow plans whose provider region is in this comma-separated list (unset = any region).
# CLOUDCRAFT_TERRAFORM_ALLOWED_REGIONS="us-east-1,eu-west-1"
# Required in production (no built-in defaults are used there): TF_VAR_db_password, TF_VAR_sql_admin_password,
# TF_VAR_admin_ssh_public_key, TF_VAR_windows_admin_password.
# How many reverse proxies / load balancers sit in front of the app (default 1). Rate limits use the client address that the
# nearest proxy recorded in X-Forwarded-For; entries further left are written by the caller and are ignored. Use 2 behind a CDN
# plus a load balancer, and 0 when the app is exposed directly (the header is then ignored).
# CLOUDCRAFT_TRUSTED_PROXY_HOPS="1"

# NOT needed to connect accounts. Users connect their OWN AWS account on the Cloud Accounts tab with their own access key and
# their own role; CloudCraft has no AWS account or identity of its own that anyone has to trust or set up.
# (Only accounts connected earlier with a role alone — no key — still use the server's own AWS identity: AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, an AWS_PROFILE, or an instance/task role. Keep such values out of git.)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# Rate-limit counters and signed-out sessions are kept in the database (tables rateLimitBucket and revokedSession; apply
# `npm run db:update` once) so every server instance shares them. "db" = always, "memory" = in this process only.
# Unset: database in production, memory in development and tests. If the database cannot be reached the app falls back to
# in-process counting and logs a warning.
# CLOUDCRAFT_SHARED_STORE="db"
# How often each instance re-reads sign-outs made on other instances, in milliseconds (default 5000, minimum 250).
# CLOUDCRAFT_REVOCATION_SYNC_MS="5000"

# A plan (apply) or teardown only runs with an approval for exactly that plan, given by an owner/admin and used once.
# Apply `npm run db:update` once to create the terraformApproval table.
#   password  the person confirms with their own CloudCraft login password, every time (the default). The confirmation is for
#             exactly that plan, works once and lasts 5 minutes; 5 wrong passwords lock them out for 15 minutes.
#   required  a DIFFERENT owner/admin than the requester must approve (use for production teams)
#   self-ok   the requester may approve their own request without a password, as an explicit step (for an identity that has no
#             password, such as a development login)
#   off       no approval needed (not recommended)
# CLOUDCRAFT_TERRAFORM_APPROVAL="password"

# Plans are limited per user (default 6 per 10 minutes); the Terraform panel shows how many are left and a countdown.
# CLOUDCRAFT_TERRAFORM_PLANS_PER_WINDOW="6"
# CLOUDCRAFT_TERRAFORM_PLAN_WINDOW_MINUTES="10"

# Development shortcuts (OFF by default). With NODE_ENV=development (npm run dev) AND this set to 1 you get conveniences that real deployments must
# never have: a shared "dev organization" for a signed-in user who has none, demo projects when the database errors or a project is missing,
# Terraform open to any owner/admin when the list above is empty, and acceptance of an ID token whose signature could not be verified.
# Only set it on a machine nobody else can reach (npm run dev listens on 127.0.0.1 only). See lib/dev/shortcuts.ts.
# CLOUDCRAFT_DEV_SHORTCUTS=1
